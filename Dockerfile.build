FROM node:24

ARG VITE_PROD_DOMAIN
ENV VITE_PROD_DOMAIN=$VITE_PROD_DOMAIN

WORKDIR /app

COPY frontend/package.json frontend/package-lock.json ./frontend/
COPY shared/package.json ./shared/

RUN cd /app/frontend && npm install && cd /app/shared && npm install

COPY frontend/ ./frontend/
COPY shared/ ./shared/

WORKDIR /app/frontend
RUN npm run build
