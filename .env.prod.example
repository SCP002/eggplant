# Production environment
# Copy to ~/apps/eggplant/.env on the production server and fill in real
# values.

# Domain
PROD_DOMAIN=your-domain.example

# PostgreSQL
POSTGRES_USER=prod-db-user
POSTGRES_PASSWORD=prod-db-password
POSTGRES_DB=eggplantdb
DATABASE_URL=postgresql://prod-db-user:prod-db-password@db:5432/eggplantdb

# Secrets
ADMIN_JWT_SECRET=prod-admin-jwt-secret
USER_JWT_SECRET=prod-user-jwt-secret

# LiveKit
LIVEKIT_API_KEY=prod-livekit-api-key
LIVEKIT_API_SECRET=prod-livekit-api-secret
LIVEKIT_URL=wss://your-domain.example/livekit

# SMTP
SMTP_HOST=smtp-server-host-address
SMTP_PORT=587
SMTP_USER=smtp-server-user
SMTP_PASSWORD=smtp-server-password
