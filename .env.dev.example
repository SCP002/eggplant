# Local development environment
# Copy to .env (gitignored) and fill in the values.

# Production domain (baked artifacts during build)
PROD_DOMAIN=your-domain.example

# PostgreSQL
POSTGRES_USER=db-user
POSTGRES_PASSWORD=db-password
POSTGRES_DB=eggplantdb
DATABASE_URL=postgresql://db-user:db-password@db:5432/eggplantdb

# Secrets
ADMIN_JWT_SECRET=dev-admin-jwt-secret
USER_JWT_SECRET=dev-user-jwt-secret

# LiveKit
LIVEKIT_API_KEY=devkey
LIVEKIT_API_SECRET=devsecret
LIVEKIT_URL=ws://localhost:7880

# SMTP
SMTP_HOST=localhost
SMTP_PORT=587
SMTP_USER=dev-smtp-user
SMTP_PASSWORD=dev-smtp-password
